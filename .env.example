# Copy to .env (never commit .env). All optional; the Dallas twin in this repository opens without any key.
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
# EARTHDATA_TOKEN=            (instead of username + password)
CESIUM_ION_TOKEN=
FIRMS_MAP_KEY=
# Ask SWELL: anthropic | openai | meta | compatible | ollama | none
SWELL_AI_PROVIDER=none
SWELL_AI_API_KEY=
SWELL_AI_MODEL=
# SWELL_AI_BASE_URL=          (only for compatible or a non-default endpoint)
